# ============================================================
# Configurações do backend — Sistema Disciplinar Escolar
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# Servidor
NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://escola:escola123@localhost:5432/escola_disciplinar
# Alternativa (componentes separados):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=escola
# DB_PASSWORD=escola123
# DB_NAME=escola_disciplinar

# JWT
JWT_SECRET=troque-isto-por-um-segredo-bem-longo-e-aleatorio-em-producao
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:8080
